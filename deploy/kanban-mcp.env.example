# kanban-mcp deployment configuration — example template.
#
# Copy this file to your environment (e.g. /etc/kanban-mcp.env, root:root 0600)
# and replace every placeholder. NEVER commit real values — only this *.example
# file belongs in the repo. All variables are optional except KANBAN_USERNAME,
# KANBAN_PASSWORD, and MCP_BEARER_TOKEN.
#
# Variable list below is the full set consumed by internal/config (T1); do not
# drop or rename any of them.

# Comma-separated host:port listen addresses; one listener per entry.
# Bind BOTH the Tailscale IP (so opencode on framework reaches the server over
# Tailscale) AND loopback (so opencode running locally on experimance talks to
# the same server). Explicitly NOT 0.0.0.0 — the service must never listen on
# all interfaces. Find your machine's Tailscale IP with `tailscale ip -4`
# (this box: 100.126.212.105).
BIND_ADDRS=<tailscale-ip>:9130,127.0.0.1:9130

# Base URL of the kanban REST API, plugin prefix included. The server re-logs
# in on 401 using the credentials below.
KANBAN_BASE_URL=http://127.0.0.1:9119/api/plugins/kanban/

# Kanban dashboard login username (required; no default).
KANBAN_USERNAME=<replace-me>

# Kanban dashboard login password (required, SECRET — keep out of the repo,
# out of logs; the server redacts it from config.String()).
KANBAN_PASSWORD=<replace-me>

# Static bearer token guarding every MCP tool call (required, SECRET, minimum
# 16 characters). Generate a fresh random value with:
#   openssl rand -hex 32
# Clients send it as `Authorization: Bearer <token>`.
MCP_BEARER_TOKEN=<replace-with-random>

# Board slug surfaced by board_list (informational only). Board-taking tools
# reject an omitted board, so this is never used as a fallback.
KANBAN_DEFAULT_BOARD=hermes-kanban-mcp

# Path (or name on PATH) of the hermes CLI binary, used for shell-out
# operations that have no REST endpoint (ticket claim, typed blocks, review
# requests).
HERMES_BIN=hermes

# Completion policy: "review" (default) blocks ticket_complete for human
# review with a review-required reason; "done" completes directly. An
# explicit review_tier: "LOW" on ticket_complete always completes to done
# regardless of this knob; MEDIUM/HIGH follow it. This governs the OLDER
# review path (a review-required block that a sweeper consumes);
# ticket_request_review is the newer native review lane and is unaffected.
MCP_COMPLETE_MODE=review

# Reviewer profile used by ticket_request_review when the caller passes no
# reviewer. Resolution: explicit reviewer argument > this.
#
# SET THIS. Whatever ends up on the review row is verified against the
# installed profile roster and the call is REFUSED when the dispatcher could
# never spawn it — including the case where neither source supplies one and
# the kernel would preserve the ticket's existing assignee. A review row on
# an unspawnable assignee is skipped on every tick: no reviewer, no runs, no
# comments. The value must be a profile the dispatcher can spawn (the profile
# that has the sdlc-review skill available), NOT a control-plane label like
# the claim worker above.
MCP_REVIEWER_PROFILE=default

# Allow operating on tickets without claiming them first (comment/advisory
# claims when the real claim backend is unavailable). Default false.
MCP_ALLOW_SKIP_CLAIM=false

# Worker identity stamped on tickets claimed through the MCP bridge.
MCP_CLAIM_WORKER=opencode-remote

# Default author name stamped on comments posted through the bridge.
MCP_COMMENT_AUTHOR=opencode-remote

# Per-IP token-bucket rate limit for MCP calls, calls per minute.
MCP_RATE_LIMIT=60

# Log level: debug, info, warn, or error.
LOG_LEVEL=info
